    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mqtt": "^5.10.4",
    "sql.js": "^1.15.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.9",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
