  "description": "Smart Locker IoT Backend with Express, SQLite and MQTT",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js"
  },
  "keywords": [
    "smart-locker",
